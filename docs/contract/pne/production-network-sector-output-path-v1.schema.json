    "EstimationStatus": {
      "description": "How a node or edge came to exist in the dataset.\n\nThis is a first-class domain semantic, not metadata. An estimated edge must never\nbe silently promoted to an observed one: downstream consumers such as\n``finance-checker`` weigh evidence by how it was produced, and an analysis run\nover mostly-``ESTIMATED`` edges warrants a different reading than one over\nobserved transactions.",
      "enum": [
        "observed",
        "estimated",
        "inferred",
        "synthetic"
      ],
      "title": "EstimationStatus",
      "type": "string"
    },
