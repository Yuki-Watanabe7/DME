{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yuki-Watanabe7/DME/blob/develop/schemas/julia-quality-export-v1.schema.json",
  "title": "Julia quality export (julia-quality-export/v1)",
  "description": "DME が所有する、Julia ツールチェーンの品質測定結果を表す機械可読 export。1ファイル=1コミットの1回の実行を表す（複数コミットの履歴をまとめない）。software-quality-dashboard の Julia Native Provider が読み取る契約。DME 側の Julia 実装は src/quality/quality_export.jl。詳細は docs/contract/julia-quality-export-v1.md と docs/adr/0016-julia-quality-export-contract.md を参照。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "export_schema",
    "producer",
    "package",
    "repository",
    "branch",
    "commit",
    "measured_at",
    "generated_at",
    "julia_version",
    "tools"
  ],
  "properties": {
    "export_schema": {
      "const": "julia-quality-export/v1"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "package": {
      "$ref": "#/$defs/package"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "commit": {
      "$ref": "#/$defs/commitSha"
    },
    "measured_at": {
      "$ref": "#/$defs/utcDateTime",
      "description": "測定対象の実行（tools のツール群）が開始した時刻。"
    },
    "generated_at": {
      "$ref": "#/$defs/utcDateTime",
      "description": "この export ファイルを書き出した時刻。measured_at 以上でなければならない。"
    },
    "julia_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/toolName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/toolExecution"
      }
    }
  },
  "$defs": {
    "commitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "utcDateTime": {
      "type": "string",
      "description": "UTC 固定（MVP 制約）。オフセット表現・小数秒は非対応。",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "toolName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$",
      "description": "tools オブジェクトのキー自体がツール名（value 側に重複したフィールドは持たない）。予約名は docs/contract/julia-quality-export-v1.md を参照（Pkg.test / Aqua.jl / JuliaFormatter.jl / Coverage.jl / JET.jl / BenchmarkTools.jl / Documenter.jl）。予約名以外の追加はスキーマの互換性を破らない（新規 metric_id 追加と同様、マイナー扱い）。"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "uuid", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "uuid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "name"],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolStatus": {
      "enum": ["success", "failure", "timeout", "skipped", "not_installed"]
    },
    "toolError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "Julia 例外型名など（例: \"OutOfMemoryError\"）。文字列で十分な場合は message と同値でもよい。"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "toolExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {
          "$ref": "#/$defs/toolStatus"
        },
        "version": {
          "type": ["string", "null"]
        },
        "started_at": {
          "anyOf": [{ "$ref": "#/$defs/utcDateTime" }, { "type": "null" }]
        },
        "completed_at": {
          "anyOf": [{ "$ref": "#/$defs/utcDateTime" }, { "type": "null" }]
        },
        "duration_seconds": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "result": {
          "type": ["object", "null"]
        },
        "error": {
          "anyOf": [{ "$ref": "#/$defs/toolError" }, { "type": "null" }]
        },
        "reason": {
          "type": ["string", "null"],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "success" } },
            "required": ["status"]
          },
          "then": {
            "required": ["started_at", "completed_at", "result"],
            "properties": {
              "started_at": { "$ref": "#/$defs/utcDateTime" },
              "completed_at": { "$ref": "#/$defs/utcDateTime" },
              "result": {
                "type": "object",
                "minProperties": 1
              },
              "error": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["failure", "timeout"] } },
            "required": ["status"]
          },
          "then": {
            "required": ["started_at", "completed_at", "error"],
            "properties": {
              "started_at": { "$ref": "#/$defs/utcDateTime" },
              "completed_at": { "$ref": "#/$defs/utcDateTime" },
              "result": { "type": "null" },
              "error": { "$ref": "#/$defs/toolError" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["skipped", "not_installed"] } },
            "required": ["status"]
          },
          "then": {
            "required": ["reason"],
            "properties": {
              "result": { "type": "null" },
              "error": { "type": "null" },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    }
  }
}
