{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yuki-Watanabe7/DME/blob/develop/schemas/japan-fiscal-scenario-result-v2.schema.json",
  "title": "Japan fiscal scenario result / rejection artifact (japan-fiscal-scenario-result/2.0.0)",
  "description": "DME が所有する Japan Fiscal Scenario Lab の result / rejection artifact。artifact_kind で判別する。Market Analyzer は DME の Julia 型を import せず、この schema と artifact だけを consume する。fail closed: schema_version・契約 version の不一致、content hash の不一致（generated_at と自身を除いた RFC 8785 正準 JSON の SHA-256）は拒否する。詳細は docs/architecture/japan_fiscal_scenario_handoff.md と docs/architecture/japan_fiscal_scenario_result_contract.md。",
  "x-contract-version": "japan-fiscal-scenario-result/2.0.0",
  "x-semantic-invariants": [
    "result_content_hash（result）/ rejection_content_hash（rejection）は、artifact から generated_at と自身を除いた RFC 8785 正準 JSON の SHA-256 と一致する。不一致は改変・破損として拒否する。",
    "coverage は DME の japan_fiscal_coverage(family, model)（同じ契約 version）と一致する。consumer は coverage を書き換えず、claim_level を昇格させない。",
    "diagnostics.claim_level・diagnostics.numeric_semantics・model_implied.baseline/scenario.numeric_semantics は coverage の claim_level・numeric_semantics と一致する。",
    "timing 診断（relative_delta・peak・trough・onset_period・duration_periods・recovery_period・thresholds）は result_shape = time_path かつ claim_level = direction_and_relative_timing のときだけ存在する。",
    "assumption_disposition は family の required_concepts・optional_concepts をこの順で 1 件ずつ持ち、model_input = applied の概念の集合は applied_inputs の概念の集合と一致する。",
    "funding_cost_legs は family = jgb_funding_cost のときだけ非 null。",
    "rejection_code = not_adopted と adoption = not_adopted は同値。"
  ],
  "oneOf": [
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/rejection"
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "RFC 8785 正準 JSON（またはファイルのバイト列）の SHA-256。"
    },
    "utcDateTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "family": {
      "type": "string",
      "enum": [
        "low_growth_high_rates",
        "fiscal_consolidation",
        "financial_repression",
        "high_growth_productivity",
        "jgb_funding_cost"
      ]
    },
    "model": {
      "type": "string",
      "enum": [
        "ramsey",
        "rbc",
        "solow",
        "islm",
        "adas",
        "new_keynesian",
        "var",
        "mundell_fleming",
        "keen",
        "sim",
        "capex_credit_cycle"
      ]
    },
    "assumptionConcept": {
      "type": "string",
      "enum": [
        "growth_path",
        "productivity_growth",
        "policy_rate",
        "long_rate_funding_condition",
        "government_spending",
        "tax",
        "primary_balance",
        "inflation",
        "cb_jgb_absorption"
      ]
    },
    "outputConcept": {
      "type": "string",
      "enum": [
        "output",
        "output_gap",
        "inflation",
        "price_level",
        "nominal_rate",
        "real_rate",
        "private_borrowing_cost",
        "private_debt",
        "employment",
        "consumption",
        "investment",
        "capital_stock",
        "government_balance",
        "government_debt_stock",
        "money_stock",
        "exchange_rate",
        "net_exports"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "none"
      ]
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "concept",
        "direction",
        "magnitude",
        "magnitude_source",
        "notes",
        "unit"
      ],
      "properties": {
        "assumption_id": {
          "type": "string",
          "minLength": 1
        },
        "concept": {
          "$ref": "#/$defs/assumptionConcept"
        },
        "unit": {
          "type": "string",
          "description": "concept から導出される単位（#274 の assumption concept registry）。consumer は読み替えない。"
        },
        "magnitude": {
          "type": "number",
          "description": "明示的な数値。0 は『変化なし』の主張であり、未指定（assumption が存在しない）とは区別される。"
        },
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "magnitude_source": {
          "type": "string",
          "enum": [
            "observed",
            "disclosed",
            "derived",
            "assumed_default"
          ],
          "description": "external_belief は受理しない（FRE の score が外部 belief を経由して magnitude へ入る経路を塞ぐ。H-04）。"
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "explicit Scenario Assumption 1 件（observed context ではない）。"
    },
    "freContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "constraint_pressure",
        "context_identity",
        "data_quality_score",
        "dimension_score",
        "dominant_drivers",
        "methodology_version",
        "notes",
        "policy_version",
        "primary_regime",
        "regime_affinity",
        "regime_confidence",
        "regime_determination",
        "regime_share",
        "snapshot_id",
        "vintage_basis"
      ],
      "properties": {
        "snapshot_id": {
          "type": "string",
          "minLength": 1
        },
        "as_of": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "vintage_basis": {
          "type": "string",
          "minLength": 1
        },
        "regime_determination": {
          "type": "string",
          "enum": [
            "primary",
            "ambiguous",
            "unavailable"
          ]
        },
        "primary_regime": {
          "type": [
            "string",
            "null"
          ]
        },
        "regime_affinity": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "archetype => affinity。評価できない archetype はキーごと欠く（0 で埋めない）。確率ではなく、shock magnitude の入力でもない。"
        },
        "regime_share": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "archetype => share。shock magnitude の入力ではない。"
        },
        "regime_confidence": {
          "type": [
            "number",
            "null"
          ]
        },
        "dimension_score": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          },
          "description": "dimension => score。評価できない dimension はキーごと欠く。"
        },
        "constraint_pressure": {
          "type": [
            "number",
            "null"
          ]
        },
        "dominant_drivers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "整列済み（並び順は意味を持たない）。"
        },
        "data_quality_score": {
          "type": [
            "number",
            "null"
          ]
        },
        "methodology_version": {
          "type": "string"
        },
        "policy_version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "context_identity": {
          "$ref": "#/$defs/sha256"
        }
      },
      "description": "FRE current snapshot（observed context のみ。JAPAN_FISCAL_FRE_CONTEXT_ROLE = observed_context_only）。どのフィールドも shock magnitude の導出に使わない。"
    },
    "diagnostic": {
      "type": "string",
      "enum": [
        "direction",
        "sign_of_delta",
        "relative_ordering",
        "peak",
        "trough",
        "onset",
        "duration",
        "recovery",
        "contribution_decomposition",
        "relative_delta",
        "absolute_delta",
        "level_path"
      ]
    },
    "channelId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "resultCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_concepts",
        "adoption",
        "calibration_basis",
        "calibration_geography",
        "cannot_state",
        "capability_contract_version",
        "claim_contract_version",
        "claim_level",
        "covered_channels",
        "family",
        "family_complete",
        "forbidden_diagnostics",
        "gap_ids",
        "major_caveats",
        "model",
        "numeric_semantics",
        "permitted_diagnostics",
        "produced_outputs",
        "representability",
        "required_concepts",
        "required_outputs",
        "uncovered_channels",
        "unsupported_concepts",
        "unsupported_outputs"
      ],
      "properties": {
        "capability_contract_version": {
          "const": "japan-fiscal-scenario-capability/1.0.0"
        },
        "claim_contract_version": {
          "const": "japan-fiscal-claim-contract/1.0.0"
        },
        "family": {
          "$ref": "#/$defs/family"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "representability": {
          "type": "string",
          "enum": [
            "representable",
            "partial"
          ]
        },
        "adoption": {
          "type": "string",
          "enum": [
            "primary",
            "supporting"
          ]
        },
        "claim_level": {
          "type": "string",
          "enum": [
            "direction_only",
            "direction_and_relative_timing"
          ]
        },
        "numeric_semantics": {
          "type": "string",
          "enum": [
            "model_unit_relative",
            "normalized_deviation"
          ]
        },
        "permitted_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "forbidden_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "required_concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumptionConcept"
          }
        },
        "accepted_concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumptionConcept"
          }
        },
        "unsupported_concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumptionConcept"
          }
        },
        "required_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputConcept"
          }
        },
        "produced_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputConcept"
          }
        },
        "unsupported_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputConcept"
          }
        },
        "covered_channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channelId"
          }
        },
        "uncovered_channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channelId"
          }
        },
        "family_complete": {
          "const": false,
          "description": "現在の契約では全セルで false。family 名だけの要約を生成しない（H-12・H-20）。"
        },
        "calibration_basis": {
          "type": "string",
          "enum": [
            "japan_calibrated",
            "non_japan_calibrated",
            "structural_illustrative",
            "not_applicable"
          ]
        },
        "calibration_geography": {
          "type": "string",
          "enum": [
            "jp",
            "us",
            "none"
          ]
        },
        "cannot_state": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "major_caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^G-[0-9]{2}$"
          }
        }
      },
      "description": "japan_fiscal_coverage(family, model) の全フィールド（H-06）。result では claim_level = magnitude・numeric_semantics = japan_magnitude・representability = not_representable・adoption = not_adopted を取らない。"
    },
    "rejectionCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted_concepts",
        "adoption",
        "calibration_basis",
        "calibration_geography",
        "cannot_state",
        "capability_contract_version",
        "claim_contract_version",
        "claim_level",
        "covered_channels",
        "family",
        "family_complete",
        "forbidden_diagnostics",
        "gap_ids",
        "major_caveats",
        "model",
        "numeric_semantics",
        "permitted_diagnostics",
        "produced_outputs",
        "representability",
        "required_concepts",
        "required_outputs",
        "uncovered_channels",
        "unsupported_concepts",
        "unsupported_outputs"
      ],
      "properties": {
        "capability_contract_version": {
          "const": "japan-fiscal-scenario-capability/1.0.0"
        },
        "claim_contract_version": {
          "const": "japan-fiscal-claim-contract/1.0.0"
        },
        "family": {
          "$ref": "#/$defs/family"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "representability": {
          "type": "string",
          "enum": [
            "representable",
            "partial",
            "not_representable"
          ]
        },
        "adoption": {
          "type": "string",
          "enum": [
            "primary",
            "supporting",
            "not_adopted"
          ]
        },
        "claim_level": {
          "type": "string",
          "enum": [
            "none",
            "direction_only",
            "direction_and_relative_timing"
          ]
        },
        "numeric_semantics": {
          "type": "string",
          "enum": [
            "none",
            "model_unit_relative",
            "normalized_deviation"
          ]
        },
        "permitted_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "forbidden_diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "required_concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumptionConcept"
          }
        },
        "accepted_concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumptionConcept"
          }
        },
        "unsupported_concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/assumptionConcept"
          }
        },
        "required_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputConcept"
          }
        },
        "produced_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputConcept"
          }
        },
        "unsupported_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/outputConcept"
          }
        },
        "covered_channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channelId"
          }
        },
        "uncovered_channels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/channelId"
          }
        },
        "family_complete": {
          "const": false,
          "description": "現在の契約では全セルで false。family 名だけの要約を生成しない（H-12・H-20）。"
        },
        "calibration_basis": {
          "type": "string",
          "enum": [
            "japan_calibrated",
            "non_japan_calibrated",
            "structural_illustrative",
            "not_applicable"
          ]
        },
        "calibration_geography": {
          "type": "string",
          "enum": [
            "jp",
            "us",
            "none"
          ]
        },
        "cannot_state": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "major_caveats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^G-[0-9]{2}$"
          }
        }
      },
      "description": "拒否されたセルの被覆情報。claim_level = none は実行対象外のセル。"
    },
    "appliedInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assumption_id",
        "concept",
        "conversion",
        "input_kind",
        "magnitude_model_units",
        "model",
        "notes",
        "target",
        "unit"
      ],
      "properties": {
        "assumption_id": {
          "type": "string",
          "minLength": 1
        },
        "concept": {
          "$ref": "#/$defs/assumptionConcept"
        },
        "model": {
          "$ref": "#/$defs/model"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "適用先のモデル変数・パラメータ名（ギリシャ文字を含みうる）。"
        },
        "input_kind": {
          "type": "string",
          "enum": [
            "exogenous_path",
            "model_parameter",
            "structural_parameter",
            "shock_process",
            "initial_state",
            "requires_structural_conversion",
            "not_accepted"
          ]
        },
        "unit": {
          "type": "string"
        },
        "magnitude_model_units": {
          "type": "number",
          "description": "単位換算後にモデルへ加えた大きさ（モデル単位）。日本の量ではない。"
        },
        "conversion": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      },
      "description": "assumption → applied model input の traceability。"
    },
    "assumptionDisposition": {
      "description": "family の概念 1 つについての assumption の有無とモデル入力としての扱い。result では、explicit assumption の黙殺・未指定の 0 化・必須概念の未指定を表す組は現れない。",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assumption_id",
            "assumption_state",
            "concept",
            "model_input",
            "requirement",
            "target"
          ],
          "properties": {
            "concept": {
              "$ref": "#/$defs/assumptionConcept"
            },
            "requirement": {
              "type": "string",
              "enum": [
                "required",
                "optional"
              ]
            },
            "assumption_state": {
              "const": "explicit"
            },
            "assumption_id": {
              "type": "string",
              "minLength": 1
            },
            "model_input": {
              "const": "applied"
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "explicit assumption を適用した。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assumption_id",
            "assumption_state",
            "concept",
            "model_input",
            "requirement",
            "target"
          ],
          "properties": {
            "concept": {
              "$ref": "#/$defs/assumptionConcept"
            },
            "requirement": {
              "type": "string",
              "enum": [
                "required",
                "optional"
              ]
            },
            "assumption_state": {
              "const": "explicit"
            },
            "assumption_id": {
              "type": "string",
              "minLength": 1
            },
            "model_input": {
              "const": "not_accepted"
            },
            "target": {
              "type": "null"
            }
          },
          "description": "explicit assumption があるがモデルが受け取れない（開示のみ・代理へ寄せない）。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assumption_id",
            "assumption_state",
            "concept",
            "model_input",
            "requirement",
            "target"
          ],
          "properties": {
            "concept": {
              "$ref": "#/$defs/assumptionConcept"
            },
            "requirement": {
              "const": "optional"
            },
            "assumption_state": {
              "const": "not_specified"
            },
            "assumption_id": {
              "type": "null"
            },
            "model_input": {
              "type": "string",
              "enum": [
                "held_at_baseline",
                "conversion_not_implemented"
              ]
            },
            "target": {
              "type": "string",
              "minLength": 1
            }
          },
          "description": "任意概念が未指定。モデル入力は baseline 値のまま（0 の assumption ではない）。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "assumption_id",
            "assumption_state",
            "concept",
            "model_input",
            "requirement",
            "target"
          ],
          "properties": {
            "concept": {
              "$ref": "#/$defs/assumptionConcept"
            },
            "requirement": {
              "type": "string",
              "enum": [
                "required",
                "optional"
              ]
            },
            "assumption_state": {
              "const": "not_specified"
            },
            "assumption_id": {
              "type": "null"
            },
            "model_input": {
              "const": "not_accepted"
            },
            "target": {
              "type": "null"
            }
          },
          "description": "未指定で、モデルも受け取れない。"
        }
      ]
    },
    "taggedSeries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numeric_semantics",
        "series"
      ],
      "properties": {
        "numeric_semantics": {
          "type": "string",
          "enum": [
            "model_unit_relative",
            "normalized_deviation"
          ],
          "description": "系列の提示のしかたの上限。model_unit_relative は符号のみ、normalized_deviation は baseline 比の偏差として提示する。系列はモデル単位の水準のまま保持され、日本の量ではない。"
        },
        "series": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/outputConcept"
          },
          "additionalProperties": {
