# DME 環境変数サンプル
# このファイルをコピーして .env を作成し、実際の値を設定してください。
# .env はgit管理対象外です（.gitignore 参照）。
#
# cp .env.example .env

# ---------------------------------------------------------------------------
# FRED（Federal Reserve Economic Data）API
# https://fred.stlouisfed.org/docs/api/api_key.html から無料取得可能
# ---------------------------------------------------------------------------
FRED_API_KEY=your_fred_api_key_here

# ---------------------------------------------------------------------------
# e-Stat（政府統計の総合窓口）API
# https://api.e-stat.go.jp/ から無料取得可能
# ---------------------------------------------------------------------------
ESTAT_APP_ID=your_estat_app_id_here

# ---------------------------------------------------------------------------
# OpenAI API（LLM 解釈・AI エコノミスト機能）
# https://platform.openai.com/api-keys から取得
# ---------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ---------------------------------------------------------------------------
# Mock / Fixture モード設定
#
# DME_DATA_MODE の選択肢:
#   live    - 実際の外部 API を使用（デフォルト）
#   fixture - ローカルの fixture データを使用（API キー不要）
#   mock    - インメモリのモックプロバイダーを使用（テスト向け）
#
# API キーが未設定の場合、自動的に fixture モードにフォールバックします。
# ---------------------------------------------------------------------------
DME_DATA_MODE=fixture

# ---------------------------------------------------------------------------
# オプション設定
# ---------------------------------------------------------------------------
# API タイムアウト（秒）
# DME_API_TIMEOUT=30

# ログレベル: debug | info | warn | error
# DME_LOG_LEVEL=info
